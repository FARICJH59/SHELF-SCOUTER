# Google AI / Gemma 4 API key
GOOGLE_API_KEY=your_google_api_key_here
GEMMA_MODEL=gemma-4-e4b-it

# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# EMQX MQTT
EMQX_HOST=
EMQX_PORT=8883
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_TLS=true
EMQX_TOPIC_PREFIX=shelf
EMQX_CLIENT_ID=
EMQX_RETRIES=3

# Optional HOARE / AEGIS / QGPS HTTP ingress
HOARE_EVENT_URL=
AEGIS_EVENT_URL=
QGPS_TELEMETRY_URL=
CONTROL_PLANE_TOKEN=
CONTROL_PLANE_TIMEOUT=5
